# Server Configuration
PORT=8080
NODE_ENV=development

# Rate Limiting
RATE_LIMIT=1000
RATE_LIMIT_WINDOW=1

# Channel Configuration
CHANNEL_BUFFER_SIZE=10000
CONSUMER_BATCH_SIZE=50
CHANNEL_TIMEOUT_MS=100

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# SQLite Configuration
SQLITE_PATH=./data
BATCH_WRITE_SIZE=100
BATCH_WRITE_INTERVAL=1000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAYS=1000,5000,10000

# Alert Configuration
ERROR_RATE_THRESHOLD=10
QUEUE_BACKLOG_THRESHOLD=5000
ZERO_THROUGHPUT_SECONDS=10
DEAD_LETTER_THRESHOLD=1000
